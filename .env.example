# Providence — API Keys and Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── External API keys ────────────────────────────────────────────

# Anthropic (Claude) — used by adaptive agents
ANTHROPIC_API_KEY=sk-ant-...

# Polygon.io — market data (price, options, news)
POLYGON_API_KEY=

# SEC EDGAR — company filings
# No API key required, but you must set a User-Agent per SEC policy:
EDGAR_USER_AGENT=Providence/0.1.0 (your-email@example.com)

# FRED — Federal Reserve Economic Data
FRED_API_KEY=

# Alpaca Markets (broker)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── Pipeline configuration ───────────────────────────────────────

PROVIDENCE_LOG_LEVEL=INFO
PROVIDENCE_DATA_DIR=/app/data
PROVIDENCE_INTERVAL_SECONDS=300
PROVIDENCE_DEFAULT_TIMEOUT=120

# ── API server ───────────────────────────────────────────────────

PROVIDENCE_API_PORT=8000
PROVIDENCE_HTTP_PORT=80
PROVIDENCE_HTTPS_PORT=443

# ── Security ─────────────────────────────────────────────────────

# API key for REST API authentication (X-API-Key header)
# If set, all non-health endpoints require this key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROVIDENCE_API_KEY=

# Environment mode: "production" enforces strict CORS, etc.
PROVIDENCE_ENV=development

# Allowed CORS origins (comma-separated, for production)
# PROVIDENCE_CORS_ORIGINS=https://app.providence.internal

# ── Container registry (for CI/CD deploy) ────────────────────────
# REGISTRY_URL=ghcr.io/your-org
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=

# ── Deploy target (for CI/CD SSH deploy) ─────────────────────────
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_SSH_KEY=
